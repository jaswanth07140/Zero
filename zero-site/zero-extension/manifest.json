{
  "action": {
    "default_popup": "popup.html",
    "default_title": "Zero Computer"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "js": [
        "content.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle"
    }
  ],
  "description": "Let Zero AI drive this Chrome browser. You watch; the AI does the work.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "externally_connectable": {
    "matches": [
      "https://zero.page.gd/*"
    ]
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "manifest_version": 3,
  "name": "Zero Computer",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms"
  ],
  "version": "1.0.1"
}