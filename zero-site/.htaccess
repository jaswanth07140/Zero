# Zero website — security hardening
# Uploaded 2026-10-09

# 1. Disable directory listing (don't show file lists)
Options -Indexes

# 2. Block direct web access to sensitive files
<Files "config.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>
<Files "config (4).php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>
<FilesMatch "^config\.backup\.\d+\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
<Files "owner-secret.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>
<Files "panel-token.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>
<FilesMatch "\.(log|dat|bak|old|sql|sqlite)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Security headers (if mod_headers available)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=()"
    # HSTS: force HTTPS for 2 years (no preload — requires registry submission)
    Header always set Strict-Transport-Security "max-age=63072000"
    # CSP: carefully scoped — site uses inline scripts/styles throughout, frames
    # arbitrary user-requested sites in webview tabs, and loads maps/tiles/fonts
    # from the allow-listed origins below. frame-src intentionally omitted so the
    # webview feature keeps working; frame-ancestors blocks clickjacking instead.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://cdnjs.cloudflare.com https://accounts.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://tile.openstreetmap.org https://server.arcgisonline.com https://api.qrserver.com https://*.googleusercontent.com; connect-src 'self' https://nominatim.openstreetmap.org https://photon.komoot.io https://router.project-osrm.org https://gmail.googleapis.com https://www.googleapis.com https://accounts.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>


# 4. Block common automated exploit scans (site is not WordPress)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^wp-(admin|login|includes|content)(/.*)?$ - [F,L]
    RewriteRule ^xmlrpc\.php$ - [F,L]
    RewriteRule ^\.git(/.*)?$ - [F,L]
    RewriteRule ^\.env$ - [F,L]
</IfModule>

# Fix MIME types for PWA install (InfinityFree serves .js as text/html by default)
<IfModule mod_mime.c>
    AddType application/javascript .js
    AddType application/manifest+json .webmanifest
    AddType application/json .json
</IfModule>
<IfModule mod_headers.c>
    <Files "sw.js">
        Header set Content-Type "application/javascript"
    </Files>
    <Files "sw.php">
        Header set Content-Type "application/javascript"
    </Files>
</IfModule>

# 7. Owner kill switch (added 2026-10-19): when offline.flag exists in the
#    site root, everything serves the offline page with a 503 — except
#    owner.php, so the owner can always bring the site back.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{DOCUMENT_ROOT}/offline.flag -f
    RewriteCond %{REQUEST_URI} !^/offline\.html$
    RewriteCond %{REQUEST_URI} !^/owner\.php$
    RewriteRule ^.*$ /offline.html [R=503,L]
</IfModule>

# 5. Don't let proxies/browsers serve stale HTML (added 2026-10-11)
<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

# 6. Cache versioned static assets aggressively (added 2026-10-12)
# Icons/images use ?v= cache-busting, so a 1-year immutable cache is safe.
<IfModule mod_headers.c>
    <FilesMatch "\.(webp|png|jpg|jpeg|gif|svg|ico|woff|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
